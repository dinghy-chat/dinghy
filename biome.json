{
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "**",
      "!docs",
      "!site",
      "!test-results",
      "!playwright-report",
      "!.dev",
      "!.playwright-mcp"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "linter": {
    "domains": { "react": "recommended" },
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      }
    }
  }
}
