{
  "name": "dinghy",
  "version": "0.30.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "ee"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "lint": "biome check . && knip",
    "test": "vitest run",
    "dev": "node apps/server/scripts/dev.ts",
    "dev:services": "docker compose -f compose.dev.yaml up -d --wait",
    "db:generate": "cd apps/server && bun x drizzle-kit generate",
    "db:check": "cd apps/server && bun x drizzle-kit generate && git diff --exit-code --quiet -- drizzle && test -z \"$(git status --porcelain -- drizzle)\"",
    "docs:build": "node site/build-docs.ts",
    "openapi:generate": "node apps/server/scripts/openapi.ts",
    "test:e2e": "playwright test --project=chromium"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@playwright/test": "^1.65.0",
    "@types/node": "24",
    "knip": "^6.45.0",
    "marked": "^18.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
