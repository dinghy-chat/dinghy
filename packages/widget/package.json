{
  "name": "@dinghy-chat/widget",
  "version": "0.31.1",
  "description": "Add the Dinghy chat to your site from code, with a typed API.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://dinghy.chat/docs/add-to-your-site",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dinghy-chat/dinghy.git",
    "directory": "packages/widget"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepack": "esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=dist/index.js && tsc -p tsconfig.npm.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "preact": "^11.2.0"
  }
}
